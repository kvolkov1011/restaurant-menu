{
  "name": "restaurant-ordering",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "concurrently --kill-others-on-fail --names menu,management \"npm run dev:menu\" \"npm run dev:management\"",
    "dev:menu": "ng serve menu",
    "dev:management": "ng serve management --port 4201",
    "build": "npm run build:menu && npm run build:management",
    "build:menu": "ng build menu",
    "build:management": "ng build management",
    "watch": "npm run watch:menu",
    "watch:menu": "ng build menu --watch --configuration development",
    "watch:management": "ng build management --watch --configuration development",
    "test": "npm run test:menu",
    "test:menu": "ng test menu",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.5",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@ngrx/signals": "^22.0.1",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.4",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.6",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
