{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": "..",
    "skipLibCheck": true,
    "paths": {
      "@data": ["./src/data/index.ts"],
      "@common": ["./../common/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
